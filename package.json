{
  "name": "@agiler/ui",
  "version": "0.5.1",
  "description": "AGILER design system — deterministic UI primitives, layout archetypes and design tokens shipped to every generated order project (write once, ship to many).",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "dist",
    "manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/styles/tokens.css",
    "./themes.css": "./src/styles/themes.css",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "manifest": "node scripts/generate-manifest.mjs",
    "manifest:check": "node scripts/check-manifest.mjs",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=18"
  }
}
